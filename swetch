char code;
int amount;

cout << "Enter currency code  E=Eure ,D= Dollar ,p = Pound : "; cin >> code;

cout << "Enter amount : ";cin >> amount;

switch (code) {
case 'E':
case 'e' :
    cout << amount << "Eure = " << amount * 51 << "EGP \n";
    break;

case 'D':
case 'd':
    cout << amount << " Dollar = " << amount * 50 << "EGP \n";
    break;

case 'P':
case 'p':
    cout << amount << " pound = " << amount * 60 << "EGP \n";
    break;

default :
    cout << "Invalid code \n ";

}

