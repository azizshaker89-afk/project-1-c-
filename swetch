char code;

cout << "Enter currency code  E=Eure ,D= Dollar ,p = Pound : "; cin >> code;

switch (code) {
  
case 'E' :
    cout << "100 Eure = " << 100 * 60 << "EGP \n";
    break;
case 'D':
    cout << "100 Dollar = " << 100 * 50 << "EGP \n";
    break;
case 'P' :
    cout << "100 pound = " << 100 * 45 << "EGP \n";
    break;
default:
    cout << "Invalid code \n ";


}

